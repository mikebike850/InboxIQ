# .streamlit/secrets.toml.example
#
# Copy this file to .streamlit/secrets.toml and fill in your values.
# secrets.toml is already in .gitignore — never commit the real file.
#
# On Streamlit Community Cloud, enter these key-value pairs in
#   App settings → Secrets
# instead of using a local file.

# ── Anthropic ─────────────────────────────────────────────────────────────────
# Required to run classifier.py (can also be set in a local .env file).
ANTHROPIC_API_KEY = "sk-ant-..."

# ── Gmail OAuth ───────────────────────────────────────────────────────────────
# Required to run ingest.py from a machine without a local credentials.json.
#
# GMAIL_CREDENTIALS_JSON
#   Paste the entire contents of credentials.json as a single string.
#   Get credentials.json from Google Cloud Console → APIs & Services → Credentials
#   (OAuth 2.0 Client ID, Desktop application type).
GMAIL_CREDENTIALS_JSON = '{"installed":{"client_id":"YOUR_CLIENT_ID.apps.googleusercontent.com","project_id":"your-project","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_secret":"YOUR_CLIENT_SECRET","redirect_uris":["http://localhost"]}}'

# GMAIL_TOKEN_B64
#   Base64-encoded pickle of your OAuth token. Generate AFTER completing the
#   local OAuth flow (python ingest.py runs it automatically on first use):
#
#     python -c "import base64; print(base64.b64encode(open('token.json','rb').read()).decode())"
#
#   Paste the output below. Refresh tokens are long-lived, but regenerate this
#   value if you ever delete token.json and re-authenticate.
GMAIL_TOKEN_B64 = "base64encodedpicklehere..."

# ── Database path (optional) ──────────────────────────────────────────────────
# Override where InboxIQ looks for inboxiq.db.
# The default (project root) is correct for most setups.
# Uncomment only if you need a custom path.
# INBOXIQ_DB_PATH = "/mount/src/inboxiq/inboxiq.db"
